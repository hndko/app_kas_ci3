# ===========================================
# Environment Configuration
# ===========================================
# Copy this file to .env and adjust the values

# Application Environment
# Accepted values: development, testing, production
CI_ENV=development

# Application Base URL (with trailing slash)
APP_BASE_URL=http://localhost/app_kas_ci3/

# ===========================================
# Database Configuration
# ===========================================
DB_HOSTNAME=localhost
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=db_kas_ci3
DB_DRIVER=mysqli
DB_PORT=3306
DB_PREFIX=
DB_CHARSET=utf8
DB_COLLATION=utf8_general_ci
